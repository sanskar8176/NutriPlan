generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  plans         Plan[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Plan {
  id            String     @id @default(cuid())
  userId        String
  name          String     @default("My Plan")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  age           Int
  gender        String
  heightCm      Float
  weightKg      Float
  activityLevel String
  goal          String
  targetRateKg  Float?
  dietType      String
  allergies     String[]   @default([])
  calories      Int
  proteinG      Int
  carbsG        Int
  fatG          Int
  bmr           Int
  tdee          Int
  bmi           Float?
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals         PlanMeal[]
}

model PlanMeal {
  id          String  @id @default(cuid())
  planId      String
  foodId      String
  mealTime    String
  position    Int     @default(0)
  aiGenerated Boolean @default(false)
  food        Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)
  plan        Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model Food {
  id          String     @id @default(cuid())
  fdcId       Int        @unique
  name        String     @unique
  calories    Float
  proteinG    Float
  carbsG      Float
  fatG        Float
  fiberG      Float      @default(0)
  servingSize String     @default("100g")
  servingG    Float      @default(100)
  image       String
  mealTimes   String[]
  dietTags    String[]
  category    String
  isActive    Boolean    @default(true)
  description String     @default("")
  planMeals   PlanMeal[]

  @@index([dietTags])
  @@index([mealTimes])
  @@index([isActive])
}

# ──────────────────────────────────────────────────────────────────────────────
# NutriPlan environment variables
# Copy to .env.local for local development. On Vercel, set the same keys under
# Project → Settings → Environment Variables. Never commit real values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Auth.js (required) ────────────────────────────────────────────────────────
# Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Local dev only. On Vercel leave it unset — the host is detected automatically.
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — the "Continue with Google" button is hidden when empty)
# Console: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Database (required) — PostgreSQL via Prisma ───────────────────────────────
# Supabase: Project → Connect → "Transaction pooler" URI (port 6543) for the app,
# and the "Session pooler" / direct URI (port 5432) for migrations.
# Example shape (do NOT paste real credentials into this file):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=""
# Direct connection used by `prisma migrate` / `prisma db push` / the seed script.
DIRECT_URL=""
# TLS is verified by default. Supabase hosts automatically use the bundled Supabase
# root CA (lib/supabase-ca.ts). For another provider with a private CA, paste the PEM here…
# DATABASE_SSL_CA=""
# …or, as a last resort for local experiments only, disable verification:
# DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# ── Local development with Docker ─────────────────────────────────────────────
#   docker run -d --name nutriplan-pg -e POSTGRES_PASSWORD=nutriplan -e POSTGRES_USER=nutriplan \
#     -e POSTGRES_DB=nutriplan -p 54329:5432 postgres:16-alpine
#   DATABASE_URL="postgresql://nutriplan:nutriplan@localhost:54329/nutriplan"
#   DIRECT_URL="postgresql://nutriplan:nutriplan@localhost:54329/nutriplan"

# ── AI meal generation (optional — falls back to DB, then to the static catalogue) ──
# Google Gemini — free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Local OpenAI-compatible model (Ollama / LM Studio) — local development only.
# Dev chain when set: Ollama → Gemini → database → static. Leave the name empty to skip.
# On Vercel the local model is always skipped (Gemini → database → static).
#   ollama serve && ollama pull llama3.2
LOCAL_MODEL_BASE_URL="http://localhost:11434/v1"
LOCAL_MODEL_NAME=""

# ── Nutrition & images (optional) ─────────────────────────────────────────────
# USDA FoodData Central — free key at https://fdc.nal.usda.gov/api-key-signup.html
# DEMO_KEY works for testing (30 req/hr per IP).
USDA_API_KEY="DEMO_KEY"

# Unsplash — free key at https://unsplash.com/developers (50 req/hr demo, 5000/hr production)
# When empty, category fallback photos are used.
UNSPLASH_ACCESS_KEY=""
